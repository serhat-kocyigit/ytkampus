# Test ortamı için İyzico ayarları. Gerçek anahtarları yalnızca .env dosyasına yazın.
IYZICO_API_KEY=sandbox-api-keyiniz
IYZICO_SECRET_KEY=sandbox-secret-keyiniz
IYZICO_API_URL=https://sandbox-api.iyzipay.com

# Canlı ortamda HTTPS zorunludur. localhost yalnızca yerel test içindir.
PAYMENT_BASE_URL=https://ornek-alanadiniz.com
CORS_ORIGIN=https://ornek-alanadiniz.com

# Skorboard uygulaması kendi MySQL veritabanını kullanır. Canlı sunucuda iki
# parolayı da güçlü ve benzersiz değerlerle değiştirin.
SCOREBOARD_DB_PASSWORD=scoreboard-local-change-before-production
SCOREBOARD_DB_ROOT_PASSWORD=scoreboard-root-local-change-before-production
SCOREBOARD_MAX_FILE_SIZE=5242880
